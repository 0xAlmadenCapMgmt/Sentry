# --- Payments (x402). Leave PAY_TO_ADDRESS unset for DEV MODE (no gate). ---
PAY_TO_ADDRESS=
# eip155:84532 = Base Sepolia (testnet, default) | eip155:8453 = Base mainnet
NETWORK=eip155:84532
# Testnet facilitator (no signup). Mainnet: CDP facilitator via @coinbase/x402.
FACILITATOR_URL=https://x402.org/facilitator
SCREEN_PRICE=$0.005
BATCH_PRICE=$0.02

# --- Receipts. Generate once: node -e "console.log(require('viem/accounts').generatePrivateKey())"
# Without it a fresh ephemeral key is used every boot (receipts won't verify across restarts).
RECEIPT_SIGNING_KEY=

# --- Server ---
PORT=4023
# DB_PATH=./data/sentry402.db
# SOURCE_SLA_HOURS=48
# INGEST_INTERVAL_HOURS=24
# DISABLE_AUTO_INGEST=1

# Rate limiting for FREE endpoints (/v1/sources, /v1/receipts). Per-IP fixed
# window; 0 disables. Paid routes are self-limiting.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120

# --- Buyer demo (agent.js) ---
# Wallet funded with Base Sepolia USDC (CDP faucet is free)
AGENT_PRIVATE_KEY=
SENTRY402_URL=http://localhost:4023

# --- Stage 4 / mainnet: set NETWORK=eip155:8453 and provide CDP credentials ---
# When NETWORK is Base mainnet, settlement uses Coinbase's CDP facilitator
# (@coinbase/x402). Create keys at https://portal.cdp.coinbase.com. REAL USDC.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
